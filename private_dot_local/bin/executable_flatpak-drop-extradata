#!/usr/bin/env bash
# flatpak-drop-extradata — 清理 flatpak 本地仓库里缓存的 extra-data 原始安装包
#
# 背景:
#   闭源应用(不可再分发)由 flatpak 在安装时现场下载厂商原始包(.deb/.txz/...),
#   下载后整个塞进该 commit 的 detached metadata(*.commitmeta)的 xa.extra-data 键里。
#   应用解包后的内容另存在 app/ 下, 这份原始包此后只在"重装同一版本"时才用得到。
#
# 代价:
#   xa.extra-data 和 GPG 签名存放在同一个 commitmeta 对象里, 没有任何 CLI 能只摘前者,
#   所以删掉意味着该 commit 的签名一并消失。签名只在 pull/install 时校验,
#   日常运行 / flatpak info / flatpak repair / flatpak update 均不读取它。
#   应用更新到新版本会拉取带全新签名的新 commit, 不受影响。
#
# 复发性:
#   每次这些应用更新, flatpak 都会为新 commit 重新下载并缓存一份。此脚本适合周期性执行。
#
# 用法:
#   flatpak-drop-extradata                  # 预演, 只报告不改动(默认)
#   flatpak-drop-extradata --apply          # 实际删除
#   flatpak-drop-extradata --apply --backup ~/fp-bak
#                                           # 移到备份目录而非删除(可原样移回)
#   flatpak-drop-extradata --apply --prune  # 顺便回收仓库里的不可达对象
#   flatpak-drop-extradata --system         # 操作系统级安装(通常需要 root)
#   flatpak-drop-extradata --repo /path/to/repo

set -euo pipefail

REPO="${HOME}/.local/share/flatpak/repo"
APPLY=0
PRUNE=0
BACKUP=""

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

usage() { sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'; exit 0; }

while [ $# -gt 0 ]; do
  case "$1" in
    --apply)   APPLY=1 ;;
    --prune)   PRUNE=1 ;;
    --system)  REPO=/var/lib/flatpak/repo ;;
    --repo)    shift; [ $# -gt 0 ] || die "--repo 需要一个路径"; REPO="$1" ;;
    --backup)  shift; [ $# -gt 0 ] || die "--backup 需要一个目录"; BACKUP="$1" ;;
    -h|--help) usage ;;
    *)         die "未知参数: $1 (用 --help 看用法)" ;;
  esac
  shift
done

[ -d "$REPO/objects" ] || die "$REPO 不像一个 ostree 仓库"
command -v ostree >/dev/null || die "找不到 ostree"

# 若 flatpak 正在跑事务, 仓库锁会被占用 —— 此时改动仓库不安全
if [ -e "$REPO/.lock" ] && command -v flock >/dev/null; then
  flock -n "$REPO/.lock" true 2>/dev/null \
    || die "仓库正被占用(flatpak 事务进行中), 请等它结束后重试"
fi

if [ -n "$BACKUP" ]; then
  [ "$APPLY" -eq 1 ] || die "--backup 需要配合 --apply"
  mkdir -p "$BACKUP" || die "无法创建备份目录 $BACKUP"
fi

# commit -> ref 名, 仅用于报告可读性
declare -A REFOF=()
if [ -d "$REPO/refs/heads" ]; then
  while IFS= read -r f; do
    read -r c < "$f" || continue
    [ -n "$c" ] && REFOF["$c"]="${f#"$REPO"/refs/heads/}"
  done < <(find "$REPO/refs/heads" -type f)
fi

total=0
count=0
failed=0

printf '仓库: %s\n' "$REPO"
[ "$APPLY" -eq 1 ] || printf '模式: 预演(未做任何改动) —— 加 --apply 才会执行\n'
printf '\n'

while IFS= read -r -d '' obj; do
  # 只认真正带缓存包的对象: 纯签名的 commitmeta 只有几百字节
  head -c 4096 "$obj" | grep -qa 'xa\.extra-data' || continue

  size=$(stat -c%s "$obj")
  commit="$(basename "$(dirname "$obj")")$(basename "$obj" .commitmeta)"
  ref="${REFOF[$commit]:-${commit:0:12}(无对应 ref)}"

  printf '%9.1f MB  %s\n' "$(awk -v s="$size" 'BEGIN{print s/1048576}')" "$ref"

  if [ "$APPLY" -eq 1 ]; then
    if [ -n "$BACKUP" ]; then
      mv -f "$obj" "$BACKUP/$commit.commitmeta" || { failed=$((failed+1)); continue; }
    else
      rm -f "$obj" || { failed=$((failed+1)); continue; }
    fi
  fi

  total=$((total + size))
  count=$((count + 1))
done < <(find "$REPO/objects" -type f -name '*.commitmeta' -print0)

printf '\n'
if [ "$count" -eq 0 ]; then
  printf '没有发现缓存的 extra-data, 无事可做。\n'
else
  verb=$([ "$APPLY" -eq 1 ] && echo "已释放" || echo "可释放")
  printf '%s: %d 个对象, %.2f GB\n' \
    "$verb" "$count" "$(awk -v s="$total" 'BEGIN{print s/1073741824}')"
  [ -n "$BACKUP" ] && printf '备份目录: %s\n' "$BACKUP"
  [ "$failed" -gt 0 ] && printf '注意: %d 个对象处理失败(权限?)\n' "$failed"
fi

if [ "$PRUNE" -eq 1 ]; then
  printf '\n回收仓库中的不可达对象...\n'
  if [ "$APPLY" -eq 1 ]; then
    ostree --repo="$REPO" prune --refs-only
  else
    ostree --repo="$REPO" prune --refs-only --no-prune
  fi
fi

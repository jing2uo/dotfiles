{
  "position": "bottom",
  "height": 42,
  "spacing": 2,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-right": [
    "network",
    "battery",
    "clock",
    "pulseaudio",
    "custom/swaync",
    "custom/wallpaper",
    "tray"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": " ",
      "2": " ",
      "3": " ",
      "4": " ",
      "5": " ",
      "6": "󰌽 ",
      "7": " ",
      "8": " ",
      "9": " ",
      "default": " "
    }
  },
  "hyprland/window": {
    "format": "{initialTitle}"
  },
  "tray": {
    "show-passive-items": true,
    "icon-size": 24,
    "spacing": 10
  },
  "clock": {
    "format": "  {:%m-%d %H:%M}",
    "locale": "C",
    "calendar": {
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      },
      "mode": "month",
      "mode-mon-col": 1,
      "on-scroll": 1
    },
    "actions": {
      "on-scroll-up": "shift_down",
      "on-scroll-down": "shift_up"
    },
    "tooltip-format": "<span color='#cdd6f4' font='monospace 16'><tt><small>{calendar}</small></tt></span>"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": " ",
    "format-icons": {
      "headphone": " ",
      "default": " "
    },
    "on-click-right": "pavucontrol",
    "on-click-middle": "pavucontrol",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip-format": "{volume}%"
  },
  "battery": {
    "bat": "BAT0",
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "  {capacity}%"
  },
  "network": {
    "interface": "wlan0",
    "format": "{ifname}: {essid} ({signalStrength}%)",
    "format-wifi": "󰖩  {signalStrength}%",
    "format-disconnected": "󱚵 ",
    "format-disabled": "󰖪 ",
    "interval": 5,
    "tooltip-format": "IP: {ipaddr}\nESSID: {essid}\nSignal: {signalStrength}%",
    "on-click-middle": "mise x -- iwmenu -l rofi -i font -s 3",
    "on-click-right": "mise x -- iwmenu -l rofi -i font -s 3"
  },
  "custom/swaync": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": " ",
      "none": " ",
      "dnd-notification": " ",
      "dnd-none": " ",
      "inhibited-notification": " ",
      "inhibited-none": " ",
      "dnd-inhibited-notification": " ",
      "dnd-inhibited-none": " "
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "escape": true
  },
  "custom/wallpaper": {
    "format": "",
    "exec": "~/.local/bin/awww.sh",
    "interval": 300,
    "tooltip": false
  }
}
